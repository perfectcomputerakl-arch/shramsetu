PORT=3000
# Generate a long random value; do not publish this file or commit real secrets.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
# Comma-separated frontend origins. Use * only for quick testing.
ALLOWED_ORIGINS=*
# On a persistent server disk, set an absolute path if needed.
DB_PATH=./shramsetu.sqlite
JWT_EXPIRES_IN=7d
